<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <g filter="url(#glow)">
    <polygon points="50,5 90,25 90,75 50,95 10,75 10,25" fill="#10B981" stroke="#059669" stroke-width="4" />
    <polygon points="50,20 65,40 80,50 65,60 50,80 35,60 20,50 35,40" fill="#ffffff" />
    <circle cx="50" cy="50" r="8" fill="#10B981" />
  </g>
</svg>
